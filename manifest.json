{
  "manifest_version": 3,
  "name": "OdysSeek",
  "version": "3.4.3",
  "description": "Busca, resalta, cita en APA, anota y exporta a Word desde cualquier página web.",
  "icons": {
    "16": "logos/icon16.png",
    "48": "logos/icon48.png",
    "128": "logos/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logos/icon16.png",
      "48": "logos/icon48.png",
      "128": "logos/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content-styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
